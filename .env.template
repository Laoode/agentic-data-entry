# Service Configuration
HOST=0.0.0.0
PORT=8000
SERVICE_NAME=Klaudia Chatbot
VERSION=1.0.0
DEBUG=true

# LLM Configuration (Google Gemini via native google-genai SDK)
LLM_MODEL=gemini-3-flash-preview
LLM_API_KEY=
LLM_TEMPERATURE=0.5

# OCR Via vLLM
VLLM_BASE_URL=
# This machine has 1 NVIDIA L4 Tensor Core graphic card (GPU) optimized for AI workloads, 8 vCPUs and 32 GB of RAM. L4 is optimized for inference workloads and smaller training workloads.
AUTH_TOKEN=
VLLM_OCR_MODEL=zai-org/GLM-OCR
# Mock mode: true while GLM-OCR fine-tuning; false once model is live
USE_MOCK_OCR=true

# LLM Guardrails Configuration (for input/output validation)
LLM_GUARDRAILS_PROMPT_INJ=meta-llama/Llama-Prompt-Guard-2-86M #for prompt injection using groq apikey
LLM_GUARDRAILS_MODEL=gemini-2.5-flash #for out of domain detection / blacklisting topic [SARA, Financial Advice]
GROQ_API_KEY= 

# Langfuse Observability
# Tracing @yintelligence.id - Development
LANGFUSE_SECRET_KEY = ""
LANGFUSE_PUBLIC_KEY = ""
LANGFUSE_BASE_URL = "https://cloud.langfuse.com"

# Sqlite
SQLITE_DB=app_dev.db

# Application Stage/Environment
STAGE=development  # development or production

# Logging Configuration
LOG_PATH=logs