# =============================================================================
# Klaudia — environment template. Copy to .env and fill in.
# Provider details & DeepSeek specifics: docs/MODELS.md
# =============================================================================

# --- Service -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
SERVICE_NAME=Klaudia Chatbot
VERSION=1.0.0
DEBUG=true
STAGE=development

# =============================================================================
# AGENTIC LLM  (supervisor + sub-agents)
# Swap backend by editing MODEL_PROVIDER + LLM_MODEL only; each provider keeps
# its own credentials below. Guardrails & KIE always use Gemini.
#   google   → Gemini (Vertex AI or Dev API)   LLM_MODEL=gemini-3-flash-preview
#   vllm     → self-hosted Qwen on vLLM         LLM_MODEL=Qwen/Qwen3.5-27B
#   deepseek → DeepSeek API                     LLM_MODEL=deepseek-v4-pro
# =============================================================================
MODEL_PROVIDER=google
LLM_MODEL=gemini-3-flash-preview
LLM_TEMPERATURE=0.5
# Force reasoning off on the agentic stack (vllm/deepseek). Keep true: thinking
# returns reasoning_content that the react tool workers don't round-trip yet.
LLM_DISABLE_THINKING=true

# Gemini thinking budgets (provider=google only): minimal|low|medium|high
LLM_THINKING_LEVEL_ROUTING=minimal
LLM_THINKING_LEVEL_WORKER=minimal

# --- provider: google (Gemini) -----------------------------------------------
# LLM_API_KEY used only when GOOGLE_GENAI_USE_VERTEXAI=False.
LLM_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=gcp_service_account.json

# --- provider: vllm (agentic Qwen — NOT the OCR server) ----------------------
VLLM_LLM_ENDPOINT=
VLLM_LLM_API_KEY=

# --- provider: deepseek ------------------------------------------------------
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# =============================================================================
# KIE / OCR  (extraction — always Gemini-native, independent of MODEL_PROVIDER)
# Routing:
#   MOCK_KIE=true                   → fixture from sample-data/labels
#   MOCK_KIE=false + OCR_MODE=false → KIE_MODEL does image→JSON directly
#   MOCK_KIE=false + OCR_MODE=true  → vLLM Qwen3.5-4B text → KIE_MODEL → JSON
# =============================================================================
MOCK_KIE=false
OCR_MODE=false
KIE_MODEL=gemini-3.1-flash-lite
# OCR vLLM server (Qwen3.5-4B) — separate box from the agentic vLLM above.
VLLM_BASE_URL=
AUTH_TOKEN=
VLLM_OCR_MODEL=Qwen/Qwen3.5-4B

# =============================================================================
# Guardrails  (always Gemini + Groq, independent of MODEL_PROVIDER)
# =============================================================================
GUARDRAILS_ENABLED=true
LLM_GUARDRAILS_PROMPT_INJ=meta-llama/Llama-Prompt-Guard-2-86M
LLM_GUARDRAILS_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=

# =============================================================================
# Observability — Langfuse v4
# =============================================================================
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# =============================================================================
# Storage & infrastructure
# =============================================================================
SQLITE_DB=app_dev.db

REDIS_URL=redis://localhost:6379/0
DEDUP_CACHE_TTL_SECONDS=86400

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=klaudia-blobs
MINIO_SECURE=false

# =============================================================================
# Extraction queue (Taskiq) + limits
# =============================================================================
TASKIQ_BROKER_URL=redis://localhost:6379/1
TASKIQ_RESULT_BACKEND_URL=redis://localhost:6379/2
TASKIQ_QUEUE_NAME=ocr:extract
TASKIQ_RESULT_TTL_SECONDS=3600

EXTRACTION_MODE=sync
EXTRACTION_PAGE_TIMEOUT_SECONDS=120
MAX_IMAGE_BYTES=10485760
MAX_PDF_BYTES=52428800
MAX_PDF_PAGES=50
MAX_IMAGES_PER_UPLOAD=5
EXTRACTION_QUEUE_DEPTH_WARN=50
EXTRACTION_QUEUE_DEPTH_REJECT=200
OCR_LORA_NAME=
OCR_SCHEMA_VERSION=v1

# --- Logging -----------------------------------------------------------------
LOG_PATH=logs
