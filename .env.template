# Service Configuration
HOST=0.0.0.0
PORT=8000
SERVICE_NAME=Klaudia Chatbot
VERSION=1.0.0
DEBUG=true

# LLM Configuration (Google Gemini via native google-genai SDK)
LLM_MODEL=gemini-3-flash-preview
LLM_API_KEY=
LLM_TEMPERATURE=0.5
LLM_THINKING_LEVEL_ROUTING=minimal
LLM_THINKING_LEVEL_WORKER=minimal

# Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_APPLICATION_CREDENTIALS=gcp_service_account.json

# OCR / KIE Routing
# Mode flow:
#   MOCK_KIE=true                            → return fixture (sample-data/labels)
#   MOCK_KIE=false + OCR_MODE=false          → KIE_MODEL does image→JSON directly
#   MOCK_KIE=false + OCR_MODE=true           → vLLM Qwen3.5-4B text recog, then KIE_MODEL → JSON
VLLM_BASE_URL=
AUTH_TOKEN=
VLLM_OCR_MODEL=Qwen/Qwen3.5-4B
MOCK_KIE=false
OCR_MODE=false
KIE_MODEL=gemini-3-flash-preview

# LLM Guardrails Configuration (for input/output validation)
LLM_GUARDRAILS_PROMPT_INJ=meta-llama/Llama-Prompt-Guard-2-86M #for prompt injection using groq apikey
LLM_GUARDRAILS_MODEL=gemini-3.1-flash-lite-preview #for out of domain detection / blacklisting topic [SARA, Financial Advice]
# gemini-3.1-flash-lite-preview
# gemini-2.5-flash
GROQ_API_KEY= 

# Langfuse Observability
# Tracing @yintelligence.id - Development
LANGFUSE_SECRET_KEY = ""
LANGFUSE_PUBLIC_KEY = ""
LANGFUSE_BASE_URL = "https://cloud.langfuse.com"

# Sqlite
SQLITE_DB=app_dev.db

# Redis (hot cache + Taskiq broker + pubsub)
REDIS_URL=redis://localhost:6379/0
DEDUP_CACHE_TTL_SECONDS=86400

# MinIO (object storage)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=klaudia-blobs
MINIO_SECURE=false

# Taskiq (extraction worker queue)
TASKIQ_BROKER_URL=redis://localhost:6379/1
TASKIQ_RESULT_BACKEND_URL=redis://localhost:6379/2
TASKIQ_QUEUE_NAME=ocr:extract
TASKIQ_RESULT_TTL_SECONDS=3600

# Extraction limits
MAX_IMAGE_BYTES=10485760            # 10 MB
MAX_PDF_BYTES=52428800               # 50 MB
MAX_PDF_PAGES=50
MAX_IMAGES_PER_UPLOAD=5
EXTRACTION_QUEUE_DEPTH_WARN=50
EXTRACTION_QUEUE_DEPTH_REJECT=200
OCR_LORA_NAME=                       # set to LoRA module name once vLLM is up
OCR_SCHEMA_VERSION=v1
# sync = inline OCR (default, dev), async = Taskiq queue + workers (prod)
EXTRACTION_MODE=sync
EXTRACTION_PAGE_TIMEOUT_SECONDS=120

# Application Stage/Environment
STAGE=development  # development or production

# Logging Configuration
LOG_PATH=logs